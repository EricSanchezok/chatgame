{
  "name": "chatgame",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --ignore-pattern '.storybook/static/**' --ignore-pattern 'e2e/artifacts/**'",
    "script:validate": "tsx scripts/validate-script.ts",
    "script:check": "npm run script:validate -- scripts/emberfall && npm run script:validate -- scripts/starlight && npm run script:validate -- test/fixtures/core-test-library/core-test-script",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run --project unit",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o .storybook/static",
    "test:ui": "vitest run --project storybook",
    "test:visual": "npm run build && playwright test --project=visual",
    "test:e2e": "npm run build && playwright test --project=e2e",
    "test:a11y": "npm run build && playwright test --project=a11y",
    "check:fast": "npm run lint && npm run typecheck && npm run test:unit && npm run script:check && node scripts/verify-decisions.mjs && node scripts/verify-doc-links.mjs && node scripts/verify-placeholders.mjs && node scripts/verify-manifest.mjs",
    "check:ui": "npm run storybook:build && npm run test:ui && npm run build && playwright test",
    "check:all": "npm run check:fast && npm run check:ui",
    "play": "tsx scripts/play-emberfall.ts",
    "import-script": "tsx scripts/import-script.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.31",
    "adm-zip": "^0.6.0",
    "ai": "^7.0.66",
    "esbuild": "^0.28.2",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/addon-vitest": "^10.5.9",
    "@storybook/nextjs-vite": "^10.5.9",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.1",
    "storybook": "^10.5.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
