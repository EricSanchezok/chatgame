{
  "name": "living-world-engine",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint --ignore-pattern 'e2e/artifacts/**'",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "world:validate": "tsx scripts/validate-world.ts",
    "world:import": "tsx scripts/import-world.ts",
    "experiment:run": "tsx scripts/experiment-run.ts",
    "execution:replay": "tsx scripts/execution-command.ts replay",
    "execution:compare": "tsx scripts/execution-command.ts compare",
    "execution:export": "tsx scripts/execution-command.ts export",
    "test:e2e": "npm run build && playwright test --project=e2e",
    "test:a11y": "npm run build && playwright test --project=a11y",
    "test:live:deepseek": "tsx scripts/smoke-deepseek.ts",
    "check:fast": "npm run lint && npm run typecheck && npm run test && npm run world:validate -- test/fixtures/open-world-script && node scripts/verify-workflow-scripts.mjs && node scripts/run-gates.mjs",
    "check:ui": "npm run test:e2e && npm run test:a11y",
    "check:all": "npm run check:fast && npm run check:ui"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.46",
    "@ai-sdk/openai-compatible": "^3.0.31",
    "@ai-sdk/xai": "^4.0.43",
    "@assistant-ui/react": "^0.15.16",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@xyflow/react": "^12.11.3",
    "adm-zip": "^0.6.0",
    "ai": "^7.0.66",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "elkjs": "^0.12.0",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "next": "16.3.1",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
