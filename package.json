{
  "name": "chatgame",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --ignore-pattern 'e2e/artifacts/**'",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "world:validate": "tsx scripts/validate-world.ts",
    "world:import": "tsx scripts/import-world.ts",
    "test:e2e": "npm run build && playwright test --project=e2e",
    "test:a11y": "npm run build && playwright test --project=a11y",
    "test:live:deepseek": "tsx scripts/smoke-deepseek.ts",
    "check:fast": "npm run lint && npm run typecheck && npm run test && npm run world:validate -- test/fixtures/open-world-script && node scripts/verify-decisions.mjs && node scripts/verify-doc-links.mjs && node scripts/verify-placeholders.mjs && node scripts/verify-manifest.mjs",
    "check:all": "npm run check:fast && npm run test:e2e && npm run test:a11y"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.31",
    "adm-zip": "^0.6.0",
    "ai": "^7.0.66",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
